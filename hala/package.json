{
  "name": "hala",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "هلا — random one-on-one text and video chat for Iraq, in Arabic and English, with interest and city matching, blurred-first video and built-in moderation.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node server/index.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@fontsource-variable/baloo-bhaijaan-2": "^5.3.0",
    "@fontsource-variable/readex-pro": "^5.3.0",
    "@types/node": "^22.18.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.10"
  }
}
